<!doctype html>
<html lang="en">
  <head>
<%- include('partials/head', { title: 'Assessments - PHRONESIS' }) %>
  </head>
  <body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen md:flex">
<%- include('partials/sidebar', { activePage: 'assessments' }) %>

    <!-- Main Container -->
    <div id="page-container" class="max-w-[480px] md:max-w-none md:ml-[260px] md:flex-1 w-full mx-auto md:mx-0 bg-background-light dark:bg-background-dark min-h-screen relative fade-in pb-20 md:pb-0">
    
<%- include('partials/header', { headerTitle: 'Assessments' }) %>

<main class="p-4 md:px-8 md:py-6 space-y-6 md:space-y-8 pb-24 md:pb-8">

      <!-- Mobile Welcome Area -->
      <section class="md:hidden">
        <h2 class="text-2xl font-bold dark:text-white">Assessments</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
          Track your upcoming tests, assignments, and projects.
        </p>
      </section>

      <!-- Filter Tabs -->
      
      <!-- Mobile Filter -->
      <div class="md:hidden flex overflow-x-auto gap-2 pb-2 hide-scrollbar">
        <button
          onclick="filterAssessments('All', this)"
          class="px-4 py-2 bg-secondary text-white rounded-full text-xs font-bold whitespace-nowrap transition-all"
        >
          All
        </button>
        <button
          onclick="filterAssessments('Upcoming', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Upcoming
        </button>
        <button
          onclick="filterAssessments('Completed', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Completed
        </button>
        <button
          onclick="filterAssessments('Overdue', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Overdue
        </button>
      </div>

      <!-- Desktop Filter -->
      <div class="hidden md:flex bg-slate-50 dark:bg-slate-900/50 rounded-lg p-1.5 gap-1 w-full max-w-[400px] border border-slate-100 dark:border-slate-800">
         <button onclick="filterAssessments('All', this)" class="flex-1 py-1.5 bg-white dark:bg-slate-800 shadow-sm text-slate-900 dark:text-white rounded-md text-sm font-bold transition-all">All</button>
         <button onclick="filterAssessments('Upcoming', this)" class="flex-1 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Upcoming</button>
         <button onclick="filterAssessments('Completed', this)" class="flex-1 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Completed</button>
         <button onclick="filterAssessments('Overdue', this)" class="flex-1 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Overdue</button>
      </div>

      <!-- Summary Cards -->
      <div class="grid grid-cols-3 gap-3 md:gap-6">
        <!-- Pending Card -->
        <div class="group relative overflow-hidden bg-primary p-3 md:p-6 rounded-2xl text-white shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 md:h-32 lg:h-36 flex flex-col justify-center border border-white/10">
          <div class="absolute -right-4 -bottom-4 opacity-[0.08] group-hover:scale-110 transition-transform duration-500 pointer-events-none">
            <span class="material-icons-outlined text-7xl md:text-8xl">pending_actions</span>
          </div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-1 md:mb-2">
              <div class="text-2xl md:text-4xl lg:text-5xl font-extrabold drop-shadow-sm leading-none">3</div>
              <div class="w-6 h-6 md:w-10 md:h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-inner">
                 <span class="material-icons-outlined text-[12px] md:text-xl">hourglass_empty</span>
              </div>
            </div>
            <p class="text-[10px] md:text-sm font-semibold opacity-90 tracking-wide mt-1">Pending</p>
          </div>
        </div>
        
        <!-- This Week Card -->
        <div class="group relative overflow-hidden bg-gradient-to-br from-secondary to-yellow-600 p-3 md:p-6 rounded-2xl text-white shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 md:h-32 lg:h-36 flex flex-col justify-center border border-white/10">
          <div class="absolute -right-4 -bottom-4 opacity-[0.08] group-hover:scale-110 transition-transform duration-500 pointer-events-none">
            <span class="material-icons-outlined text-7xl md:text-8xl">date_range</span>
          </div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-1 md:mb-2">
              <div class="text-2xl md:text-4xl lg:text-5xl font-extrabold drop-shadow-sm leading-none">5</div>
              <div class="w-6 h-6 md:w-10 md:h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-inner">
                 <span class="material-icons-outlined text-[12px] md:text-xl">today</span>
              </div>
            </div>
            <p class="text-[10px] md:text-sm font-semibold opacity-90 tracking-wide mt-1">This Week</p>
          </div>
        </div>

        <!-- Completed Card -->
        <div class="group relative overflow-hidden bg-secondary p-3 md:p-6 rounded-2xl text-white shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 md:h-32 lg:h-36 flex flex-col justify-center border border-white/10">
          <div class="absolute -right-4 -bottom-4 opacity-[0.08] group-hover:scale-110 transition-transform duration-500 pointer-events-none">
            <span class="material-icons-outlined text-7xl md:text-8xl">task_alt</span>
          </div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-1 md:mb-2">
              <div class="text-2xl md:text-4xl lg:text-5xl font-extrabold drop-shadow-sm leading-none">12</div>
              <div class="w-6 h-6 md:w-10 md:h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-inner">
                 <span class="material-icons-outlined text-[12px] md:text-xl">check_circle</span>
              </div>
            </div>
            <p class="text-[10px] md:text-sm font-semibold opacity-90 tracking-wide mt-1">Completed</p>
          </div>
        </div>
      </div>

      <!-- Upcoming Assessments -->
      <section class="assessment-section space-y-3 md:space-y-4">
        <h3 class="text-lg md:text-xl font-bold dark:text-white flex items-center gap-2 mb-2 md:mb-4">
          <span class="material-icons-outlined text-primary">priority_high</span>
          Due Soon
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 lg:gap-6">
        <!-- Mathematics Test - URGENT -->
        <div
          class="assessment-card bg-white dark:bg-slate-800 p-4 rounded-xl border-l-4 border-primary shadow-lg cursor-pointer transition-transform active:scale-[0.98]"
          data-category="Upcoming"
          onclick="showAssessmentDetails('Mid-Term Test', 'Mathematics', 'Upcoming', 'Tomorrow, Feb 9', 'Room 204 • 8:00 AM - 10:00 AM')"
        >
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex items-center justify-center">
                <span class="material-icons-outlined text-xl">quiz</span>
              </div>
              <div>
                <h4 class="text-sm font-bold">Mid-Term Test</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Mathematics</p>
              </div>
            </div>
            <span class="px-2 py-1 bg-primary/10 text-primary dark:text-blue-400 text-[9px] font-bold rounded-full">
              URGENT
            </span>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">calendar_today</span>
              <span class="text-slate-600 dark:text-slate-400">Due: Tomorrow, Feb 9</span>
            </div>
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">schedule</span>
              <span class="text-slate-600 dark:text-slate-400">8:00 AM - 10:00 AM</span>
            </div>
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">location_on</span>
              <span class="text-slate-600 dark:text-slate-400">Room 204</span>
            </div>
          </div>
          <button class="w-full mt-3 py-2 bg-primary hover:bg-blue-700 text-white rounded-lg text-[10px] font-semibold transition-colors">
            View Details
          </button>
        </div>

        <!-- Chemistry Assignment -->
        <div
          class="assessment-card bg-white dark:bg-slate-800 p-4 rounded-xl border-l-4 border-secondary shadow-sm cursor-pointer transition-transform active:scale-[0.98]"
          data-category="Upcoming"
          onclick="showAssessmentDetails('Lab Report', 'Chemistry', 'Upcoming', 'Feb 11, 2026', 'Instructor: Dr. Williams • Lab Submission')"
        >
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-secondary/10 text-secondary rounded-lg flex items-center justify-center">
                <span class="material-icons-outlined text-xl">assignment</span>
              </div>
              <div>
                <h4 class="text-sm font-bold">Lab Report</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Chemistry</p>
              </div>
            </div>
            <span class="px-2 py-1 bg-secondary/10 text-secondary text-[9px] font-bold rounded-full">
              3 DAYS
            </span>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">calendar_today</span>
              <span class="text-slate-600 dark:text-slate-400">Due: Feb 11, 2026</span>
            </div>
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">person</span>
              <span class="text-slate-600 dark:text-slate-400">Dr. Williams</span>
            </div>
          </div>
          <div class="mt-3">
            <div class="flex items-center justify-between text-[10px] mb-1">
              <span class="text-slate-500 dark:text-slate-400">Progress</span>
              <span class="font-bold text-secondary">60%</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2">
              <div class="bg-secondary h-2 rounded-full" style="width: 60%"></div>
            </div>
          </div>
        </div>

        <!-- Biology Project -->
        <div
          class="assessment-card bg-white dark:bg-slate-800 p-4 rounded-xl border-l-4 border-primary shadow-sm cursor-pointer transition-transform active:scale-[0.98]"
          data-category="Upcoming"
          onclick="showAssessmentDetails('Group Project', 'Biology', 'Upcoming', 'Feb 15, 2026', 'Team Project • 4 Students • Topic: Photosynthesis')"
        >
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex items-center justify-center">
                <span class="material-icons-outlined text-xl">science</span>
              </div>
              <div>
                <h4 class="text-sm font-bold">Group Project</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Biology</p>
              </div>
            </div>
            <span class="px-2 py-1 bg-primary/10 text-primary dark:text-blue-400 text-[9px] font-bold rounded-full">
              1 WEEK
            </span>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">calendar_today</span>
              <span class="text-slate-600 dark:text-slate-400">Due: Feb 15, 2026</span>
            </div>
            <div class="flex items-center gap-2 text-[11px]">
              <span class="material-icons-outlined text-[14px] text-slate-400">group</span>
              <span class="text-slate-600 dark:text-slate-400">Team of 4 students</span>
            </div>
          </div>
          <div class="mt-3">
            <div class="flex items-center justify-between text-[10px] mb-1">
              <span class="text-slate-500 dark:text-slate-400">Progress</span>
              <span class="font-bold text-primary dark:text-blue-400">25%</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 rounded-full h-2">
              <div class="bg-primary h-2 rounded-full" style="width: 25%"></div>
            </div>
          </div>
        </div>
        </div> <!-- end Upcoming Grid -->
      </section>

      <!-- Completed Assessments -->
      <section class="assessment-section space-y-3 md:space-y-4">
        <h3 class="text-lg md:text-xl font-bold dark:text-white flex items-center gap-2 mb-2 md:mb-4">
          <span class="material-icons-outlined text-secondary">check_circle</span>
          Recently Completed
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 lg:gap-6">
        <!-- English Essay - Completed -->
        <div
          class="assessment-card bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 shadow-sm opacity-75 cursor-pointer transition-transform active:scale-[0.98]"
          data-category="Completed"
          onclick="showAssessmentDetails('Literary Essay', 'English Language', 'Completed', 'Submitted: Feb 5, 2026', 'Grading Pending • Topic: Shakespearean Sonnets')"
        >
          <div class="flex items-start justify-between mb-2">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex items-center justify-center">
                <span class="material-icons-outlined text-xl">check</span>
              </div>
              <div>
                <h4 class="text-sm font-bold">Literary Essay</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">English Language</p>
              </div>
            </div>
            <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 text-[9px] font-bold rounded-full">
              SUBMITTED
            </span>
          </div>
          <div class="flex items-center gap-2 text-[11px]">
            <span class="material-icons-outlined text-[14px] text-slate-400">calendar_today</span>
            <span class="text-slate-600 dark:text-slate-400">Submitted: Feb 5, 2026</span>
          </div>
        </div>

        <!-- Physics Quiz - Completed -->
        <div
          class="assessment-card bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 shadow-sm opacity-75 cursor-pointer transition-transform active:scale-[0.98]"
          data-category="Completed"
          onclick="showAssessmentDetails('Weekly Quiz', 'Physics', 'Completed', 'Completed: Feb 3, 2026', 'Final Score: 88% (A-)')"
        >
          <div class="flex items-start justify-between mb-2">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex items-center justify-center">
                <span class="material-icons-outlined text-xl">check</span>
              </div>
              <div>
                <h4 class="text-sm font-bold">Weekly Quiz</h4>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Physics</p>
              </div>
            </div>
            <div class="text-right">
              <div class="text-lg font-bold text-primary dark:text-blue-400">A-</div>
              <p class="text-[9px] text-slate-500 dark:text-slate-400">88%</p>
            </div>
          </div>
          <div class="flex items-center gap-2 text-[11px]">
            <span class="material-icons-outlined text-[14px] text-slate-400">calendar_today</span>
            <span class="text-slate-600 dark:text-slate-400">Completed: Feb 3, 2026</span>
          </div>
        </div>
        </div> <!-- end Completed Grid -->
      </section>
    
    </main>

<%- include('partials/bottom-nav', { activePage: 'assessments' }) %>
<%- include('partials/modals') %>

    </div>
  </body>
</html>