<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title><%= typeof title !== 'undefined' ? title : 'Error' %> — PHRONESIS</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet"/>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#4169E1",
              secondary: "#D4AF37",
              "background-light": "#F8FAFC",
              "background-dark": "#0F172A",
            },
            fontFamily: { display: ["Inter", "sans-serif"] },
          },
        },
      };
    </script>
    <style>
      body { font-family: "Inter", sans-serif; }
      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50%       { transform: translateY(-14px); }
      }
      .float { animation: float 5s ease-in-out infinite; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .fade-up { animation: fadeUp 0.6s ease-out forwards; }
      .fade-up-delay { animation: fadeUp 0.6s 0.15s ease-out both; }
      .fade-up-delay-2 { animation: fadeUp 0.6s 0.3s ease-out both; }
    </style>
    <script>
      // Apply saved theme immediately to prevent flash
      (function () {
        const saved = localStorage.getItem('theme') || 'light';
        if (saved === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
    <!-- Toast system for any in-page notifications -->
    <script src="/js/toast.js"></script>
  </head>
  <body class="min-h-screen bg-background-light dark:bg-background-dark flex flex-col items-center justify-center px-6 py-16 overflow-x-hidden">

    <!-- Decorative background blobs -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-primary/10 dark:bg-primary/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-secondary/10 dark:bg-secondary/5 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 w-full max-w-md text-center space-y-8">

      <!-- Floating status code icon -->
      <div class="float mx-auto w-28 h-28 rounded-full flex items-center justify-center shadow-2xl
        <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
          bg-blue-50 dark:bg-blue-900/20 border-2 border-blue-100 dark:border-blue-800/50
        <% } else { %>
          bg-red-50 dark:bg-red-900/20 border-2 border-red-100 dark:border-red-800/50
        <% } %>
      ">
        <span class="material-icons-outlined text-5xl
          <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
            text-primary dark:text-blue-400
          <% } else { %>
            text-red-500 dark:text-red-400
          <% } %>
        ">
          <%= (typeof statusCode !== 'undefined' && statusCode === 404) ? 'search_off' : 'error_outline' %>
        </span>
      </div>

      <!-- Status code badge -->
      <div class="fade-up">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-black tracking-widest uppercase
          <% if (typeof statusCode !== 'undefined' && statusCode === 404) { %>
            bg-blue-100 dark:bg-blue-900/30 text-primary dark:text-blue-300
          <% } else { %>
            bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-300
          <% } %>
        ">
          Error <%= typeof statusCode !== 'undefined' ? statusCode : '500' %>
        </span>
      </div>

      <!-- Title & message -->
      <div class="fade-up-delay space-y-3">
        <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          <%= typeof title !== 'undefined' ? title : 'Something Went Wrong' %>
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-sm mx-auto">
          <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred. Please try again or contact support if the problem continues.' %>
        </p>
      </div>

      <!-- Action buttons -->
      <div class="fade-up-delay-2 flex flex-col sm:flex-row gap-3 justify-center pt-2">
        <% if (typeof backUrl !== 'undefined' && backUrl) { %>
          <a href="<%= backUrl %>"
             class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-white rounded-2xl font-bold text-sm shadow-lg shadow-primary/20 hover:bg-blue-700 transition-all active:scale-[0.98]">
            <span class="material-icons-outlined text-sm">arrow_back</span>
            <%= typeof backLabel !== 'undefined' ? backLabel : 'Go Back' %>
          </a>
        <% } %>
        <a href="/"
           class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-2xl font-bold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-all active:scale-[0.98]">
          <span class="material-icons-outlined text-sm">home</span>
          Home Page
        </a>
      </div>

      <!-- Branding footer -->
      <div class="pt-6 border-t border-slate-200/60 dark:border-slate-800">
        <p class="text-[10px] font-bold text-slate-400 dark:text-slate-600 uppercase tracking-widest">PHRONESIS Academy</p>
        <p class="text-[9px] text-slate-400 dark:text-slate-600 mt-1">© 2026 All Rights Reserved</p>
      </div>

    </div>
  </body>
</html>
