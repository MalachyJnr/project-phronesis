<!doctype html>
<html lang="en">
  <head>
<%- include('partials/head', { title: 'Student Home Dashboard - PHRONESIS' }) %>
    <script>
      // Timetable data for each day dynamically populated from database
      const timetableData = JSON.parse(atob('<%= Buffer.from(JSON.stringify(timetableDataGrouped)).toString("base64") %>'));

      // Color classes for different subjects
      const colorClasses = {
        primary: 'bg-primary/10 text-primary dark:text-blue-400',
        secondary: 'bg-secondary/10 text-secondary',
        neutral: 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400',
        break: 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400'
      };

      function switchDashboardDay(day) {
        // Update button states
        document.querySelectorAll('.day-btn').forEach(btn => {
          if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(day)) {
            if (btn.classList.contains('desktop-day-btn')) {
              btn.className = 'day-btn desktop-day-btn px-4 py-1.5 bg-white dark:bg-slate-800 shadow-sm text-slate-900 dark:text-white rounded-md text-xs font-bold transition-all';
            } else {
              btn.className = 'day-btn mobile-day-btn px-4 py-2 bg-secondary text-white rounded-full text-xs font-bold whitespace-nowrap transition-all shadow-sm';
            }
          } else {
            if (btn.classList.contains('desktop-day-btn')) {
              btn.className = 'day-btn desktop-day-btn px-4 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-medium transition-all rounded-md';
            } else {
              btn.className = 'day-btn mobile-day-btn px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all';
            }
          }
        });

        // Update label
        const dayLabel = document.getElementById('current-day-label');
        if (dayLabel) dayLabel.textContent = day;

        // Update timetable content
        const schedule = timetableData[day].slice(0, 3);
        const container = document.getElementById('timetable-container');
        
        const htmlContent = schedule.map(item => {
          if (item.color === 'break') {
            return `
              <div class="bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-10 ${colorClasses.neutral} rounded-lg flex flex-col items-center justify-center">
                    <span class="text-[10px] font-bold">${item.time}</span>
                  </div>
                  <div>
                    <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 italic">
                      ${item.subject}
                    </h4>
                  </div>
                </div>
              </div>
            `;
          } else {
            return `
              <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 ${colorClasses.primary} rounded-lg flex flex-col items-center justify-center">
                    <span class="text-[10px] font-bold">${item.time}</span>
                    <span class="text-[8px] uppercase">${item.period}</span>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold">${item.subject}</h4>
                    <p class="text-[10px] text-slate-500 dark:text-slate-400">
                      ${item.room} • ${item.teacher}
                    </p>
                  </div>
                </div>
                <button class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors text-slate-300 hover:text-primary dark:hover:text-blue-400" onclick="toggleTimetableMenu(event, '${item.subject}')">
                  <span class="material-icons-outlined">more_vert</span>
                </button>
              </div>
            `;
          }
        }).join('');
        
        container.innerHTML = `<div class="schedule-section space-y-3">${htmlContent}</div>`;
      }

      // Dark mode toggle functionality
      function toggleTheme() {
        const html = document.documentElement;
        const currentTheme = html.classList.contains('dark') ? 'dark' : 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        
        if (newTheme === 'dark') {
          html.classList.add('dark');
          document.getElementById('theme-icon').textContent = 'light_mode';
          if(document.getElementById('theme-icon-desktop')) document.getElementById('theme-icon-desktop').textContent = 'light_mode';
        } else {
          html.classList.remove('dark');
          document.getElementById('theme-icon').textContent = 'dark_mode';
          if(document.getElementById('theme-icon-desktop')) document.getElementById('theme-icon-desktop').textContent = 'dark_mode';
        }
        
        // Save preference to localStorage
        localStorage.setItem('theme', newTheme);
      }

      // Initialize theme on page load
      document.addEventListener('DOMContentLoaded', function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        const html = document.documentElement;
        
        if (savedTheme === 'dark') {
          html.classList.add('dark');
          if(document.getElementById('theme-icon')) document.getElementById('theme-icon').textContent = 'light_mode';
          if(document.getElementById('theme-icon-desktop')) document.getElementById('theme-icon-desktop').textContent = 'light_mode';
        } else {
          html.classList.remove('dark');
          if(document.getElementById('theme-icon')) document.getElementById('theme-icon').textContent = 'dark_mode';
          if(document.getElementById('theme-icon-desktop')) document.getElementById('theme-icon-desktop').textContent = 'dark_mode';
        }
      });
    </script>
  </head>
  <body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen md:flex">
<%- include('partials/sidebar', { activePage: 'home' }) %>

    <!-- Main Container -->
    <div id="page-container" class="max-w-[480px] md:max-w-none md:ml-[260px] md:flex-1 w-full mx-auto md:mx-0 bg-background-light dark:bg-background-dark min-h-screen relative fade-in pb-20 md:pb-0">
    
<%- include('partials/header', { headerTitle: 'Welcome, ' + (typeof user !== 'undefined' && user ? user.first_name : 'Student') + '!' }) %>

<main class="p-4 md:px-8 md:py-6 space-y-6 md:space-y-8 pb-24 md:pb-8">

      <!-- Mobile Welcome Area -->
      <section class="md:hidden">
        <h2 class="text-2xl font-bold dark:text-white">Welcome, <%= typeof user !== 'undefined' && user ? user.first_name : 'Student' %>!</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
          Here's a quick overview of your current status.
        </p>
      </section>

      <% if (typeof user !== 'undefined' && user && user.is_default_password) { %>
        <!-- Security Reminder Banner -->
        <div id="default-password-banner" class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/50 p-4 md:p-5 rounded-2xl shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-800/50 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0">
              <span class="material-icons-outlined text-xl">warning</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-amber-900 dark:text-amber-200 uppercase tracking-wider">Security Notice</h4>
              <p class="text-xs text-amber-800 dark:text-amber-300 mt-1 leading-relaxed">
                Your account is still using the default password assigned by the administrator (<strong><%= typeof defaultStudentPassword !== 'undefined' ? defaultStudentPassword : 'Password123' %></strong>). For the security of your account, it is strongly recommended that you change your password as soon as possible.
              </p>
            </div>
          </div>
          <button onclick="openChangePasswordModal()" class="w-full md:w-auto px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold whitespace-nowrap transition-colors shadow-sm flex items-center justify-center gap-1.5 shrink-0">
            <span class="material-icons-outlined text-sm">lock_reset</span>
            Change Password
          </button>
        </div>
      <% } %>

      <!-- Dashboard Stats Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
        <!-- Attendance Card -->
        <div class="bg-[#3B82F6] p-5 md:p-6 rounded-2xl text-white shadow-lg shadow-blue-500/10 flex flex-col justify-between h-40 md:h-48 relative overflow-hidden group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium text-white/90">Attendance</span>
            <span class="material-icons-outlined text-xl text-white/80">calendar_month</span>
          </div>
          <div>
            <div class="text-4xl md:text-5xl font-bold mb-1 tracking-tight"><%= typeof attendance !== 'undefined' && attendance ? Math.round(attendance.percentage) : '90' %>%</div>
          </div>
          <div class="mt-auto flex items-end justify-between">
            <p class="text-[11px] md:text-sm font-light text-white/90 leading-tight max-w-[100px] md:max-w-[120px]"><%= typeof attendance !== 'undefined' && attendance ? attendance.remarks : 'Good attendance!' %></p>
            <a href="/student/results" class="px-3 py-1.5 md:px-4 md:py-2 bg-white/20 hover:bg-white/30 rounded-lg text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap backdrop-blur-sm">
              View Details
            </a>
          </div>
        </div>

        <!-- GPA Card -->
        <div class="bg-[#FBBF24] p-5 md:p-6 rounded-2xl text-white shadow-lg shadow-amber-500/10 flex flex-col justify-between h-40 md:h-48 relative overflow-hidden group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium text-white/90">GPA</span>
            <span class="material-icons-outlined text-xl text-white/80">star</span>
          </div>
          <div>
            <div class="text-4xl md:text-5xl font-bold mb-1 tracking-tight"><%= typeof resultSummary !== 'undefined' && resultSummary ? resultSummary.gpa : '3.80' %></div>
          </div>
          <div class="mt-auto flex items-end justify-between">
            <p class="text-[11px] md:text-sm font-light text-white/90 leading-tight max-w-[100px] md:max-w-[120px]">
              <% if (typeof resultSummary !== 'undefined' && resultSummary) { %>
                Rank: <%= resultSummary.class_position %> / <%= resultSummary.total_students %>
              <% } else { %>
                Current GPA - Keep it up!
              <% } %>
            </p>
            <a href="/student/results" class="px-3 py-1.5 md:px-4 md:py-2 bg-white/20 hover:bg-white/30 rounded-lg text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap backdrop-blur-sm">
              View Details
            </a>
          </div>
        </div>

        <!-- Payment Status Card -->
        <div class="col-span-2 lg:col-span-1 bg-primary p-5 md:p-6 rounded-2xl text-white shadow-lg shadow-blue-500/10 flex flex-col justify-between h-40 md:h-48 relative overflow-hidden group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-medium text-white/90">Payment Status</span>
            <span class="material-icons-outlined text-xl text-white/80">payments</span>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 tracking-tight"><%= typeof paymentSummary !== 'undefined' && paymentSummary ? paymentSummary.status : 'Up-to-Date' %></div>
          </div>
          <div class="mt-auto flex items-end justify-between">
            <p class="text-[11px] md:text-sm font-light text-white/90 leading-tight">
              Balance: ₦<%= typeof paymentSummary !== 'undefined' && paymentSummary ? paymentSummary.outstandingBalance.toLocaleString() : '0.00' %>
            </p>
            <a href="/student/payments" class="px-3 py-1.5 md:px-4 md:py-2 bg-white/20 hover:bg-white/30 rounded-lg text-[10px] md:text-xs font-bold transition-colors whitespace-nowrap backdrop-blur-sm">
              View Details
            </a>
          </div>
        </div>
      </div>

      <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm p-4 md:p-6 space-y-4 md:space-y-6">
        <div class="flex items-center justify-between pb-2 md:pb-4 border-b border-slate-100 dark:border-slate-700">
          <h2 class="text-lg font-bold dark:text-white">Weekly Timetable</h2>
          
          <!-- Desktop Tabs -->
          <div class="hidden md:flex bg-slate-50 dark:bg-slate-900 rounded-lg p-1 gap-1">
            <button class="day-btn desktop-day-btn px-4 py-1.5 bg-white dark:bg-slate-800 shadow-sm text-slate-900 dark:text-white rounded-md text-xs font-bold transition-all" onclick="switchDashboardDay('Monday')">Mon</button>
            <button class="day-btn desktop-day-btn px-4 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-medium transition-all rounded-md" onclick="switchDashboardDay('Tuesday')">Tue</button>
            <button class="day-btn desktop-day-btn px-4 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-medium transition-all rounded-md" onclick="switchDashboardDay('Wednesday')">Wed</button>
            <button class="day-btn desktop-day-btn px-4 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-medium transition-all rounded-md" onclick="switchDashboardDay('Thursday')">Thu</button>
            <button class="day-btn desktop-day-btn px-4 py-1.5 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 text-xs font-medium transition-all rounded-md" onclick="switchDashboardDay('Friday')">Fri</button>
          </div>

          <!-- Mobile Label -->
          <div class="md:hidden flex items-center gap-2 text-primary dark:text-blue-400">
            <span id="current-day-label" class="text-xs font-semibold">Monday</span>
            <span class="material-icons-outlined text-sm">calendar_today</span>
          </div>
        </div>
        
        <!-- Mobile Tabs -->
        <div class="flex md:hidden overflow-x-auto gap-2 pb-2 hide-scrollbar">
          <button
            class="day-btn mobile-day-btn px-4 py-2 bg-secondary text-white rounded-full text-xs font-bold whitespace-nowrap transition-all shadow-sm"
            onclick="switchDashboardDay('Monday')"
          >
            Monday
          </button>
          <button
            class="day-btn mobile-day-btn px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
            onclick="switchDashboardDay('Tuesday')"
          >
            Tuesday
          </button>
          <button
            class="day-btn mobile-day-btn px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
            onclick="switchDashboardDay('Wednesday')"
          >
            Wednesday
          </button>
          <button
            class="day-btn mobile-day-btn px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
            onclick="switchDashboardDay('Thursday')"
          >
            Thursday
          </button>
          <button
            class="day-btn mobile-day-btn px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
            onclick="switchDashboardDay('Friday')"
          >
            Friday
          </button>
        </div>
        <div id="timetable-container" class="relative">
          <!-- Monday Schedule -->
          <div id="monday-schedule" class="schedule-section space-y-3">
            <% if (timetableDataGrouped.Monday && timetableDataGrouped.Monday.length > 0) { %>
              <% timetableDataGrouped.Monday.slice(0, 3).forEach(function(item) { %>
                <% if (item.color === 'break') { %>
                  <div class="bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-10 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 rounded-lg flex flex-col items-center justify-center">
                        <span class="text-[10px] font-bold"><%= item.time %></span>
                      </div>
                      <div>
                        <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 italic">
                          <%= item.subject %>
                        </h4>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-12 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex flex-col items-center justify-center">
                        <span class="text-[10px] font-bold"><%= item.time %></span>
                        <span class="text-[8px] uppercase"><%= item.period %></span>
                      </div>
                      <div>
                        <h4 class="text-sm font-bold"><%= item.subject %></h4>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400">
                          <%= item.room %> • <%= item.teacher %>
                        </p>
                      </div>
                    </div>
                    <button class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors text-slate-300 hover:text-primary dark:hover:text-blue-400" onclick="toggleTimetableMenu(event, '<%= item.subject %>')">
                      <span class="material-icons-outlined">more_vert</span>
                    </button>
                  </div>
                <% } %>
              <% }); %>
            <% } else { %>
              <div class="py-8 text-center text-slate-500 dark:text-slate-400">
                <p class="text-sm">No classes scheduled for Monday</p>
              </div>
            <% } %>
          </div>
        </div>
        <a
          href="/student/timetable"
          class="w-full py-3 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-primary dark:text-blue-400 rounded-xl text-xs font-bold transition-all hover:bg-slate-50 dark:hover:bg-slate-700/50 active:scale-[0.98] mt-4 flex items-center justify-center gap-2"
        >
          View Full Timetable <span class="material-icons-outlined text-sm">arrow_forward</span>
        </a>
      </section>

      <!-- Recent Assessments & Announcements -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 mt-6">
        <!-- Recent Assessments -->
        <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm p-5 md:p-6">
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-white">Recent Assessments</h3>
            <a href="/student/assessments" class="text-xs font-bold text-primary dark:text-blue-400 hover:underline">See all</a>
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
                <div>
                  <p class="text-sm font-bold text-slate-900 dark:text-white">Calculus II Midterm</p>
                  <p class="text-xs text-slate-500">Nov 10, 2023</p>
                </div>
              </div>
              <span class="text-sm font-bold text-green-600 dark:text-green-400">A-</span>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                <div>
                  <p class="text-sm font-bold text-slate-900 dark:text-white">Biology Lab Report</p>
                  <p class="text-xs text-slate-500">Nov 08, 2023</p>
                </div>
              </div>
              <span class="text-sm font-bold text-slate-900 dark:text-white">Pending</span>
            </div>
          </div>
        </section>
        
        <!-- Announcements -->
        <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm p-5 md:p-6">
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100 dark:border-slate-700">
            <h3 class="font-bold text-slate-900 dark:text-white">Announcements</h3>
          </div>
          <div class="space-y-4">
            <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
              <% announcements.forEach(function(item) { %>
                <div class="border-l-2 border-primary pl-3">
                  <p class="text-[10px] font-bold text-primary dark:text-blue-400 uppercase tracking-wider mb-0.5"><%= item.category %></p>
                  <p class="text-sm font-bold text-slate-900 dark:text-white"><%= item.title %></p>
                  <p class="text-xs text-slate-500 mt-1 line-clamp-2"><%= item.content %></p>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-xs text-slate-500">No recent announcements.</p>
            <% } %>
          </div>
        </section>
      </div>
    
    </main>

<%- include('partials/bottom-nav', { activePage: 'home' }) %>
<%- include('partials/modals') %>

    </div>
  </body>
</html>