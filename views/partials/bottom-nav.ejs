<%
  const bottomNavItems = [
    { href: '/student/dashboard', icon: 'home', label: 'Home', id: 'home' },
    { href: '/student/results', icon: 'fact_check', label: 'Results', id: 'results' },
    { href: '/student/timetable', icon: 'calendar_today', label: 'Timetable', id: 'timetable' },
    { href: '/student/assessments', icon: 'description', label: 'Assessments', id: 'assessments' },
    { href: '/student/payments', icon: 'payments', label: 'Payments', id: 'payments' }
  ];
%>
    <nav
      class="md:hidden fixed bottom-0 left-0 right-0 max-w-[480px] mx-auto bg-white/80 dark:bg-slate-900/80 glass-card border-t border-slate-100 dark:border-slate-800 bottom-nav-safe z-30"
    >
      <div class="flex justify-around items-center py-3">
        <% bottomNavItems.forEach(function(item) { %>
          <a class="flex flex-col items-center gap-1 <%= typeof activePage !== 'undefined' && activePage === item.id ? 'text-secondary' : 'text-slate-400 dark:text-slate-500' %>" href="<%= item.href %>">
            <span class="material-icons-outlined"><%= item.icon %></span>
            <span class="text-[10px] <%= typeof activePage !== 'undefined' && activePage === item.id ? 'font-bold' : 'font-medium' %>"><%= item.label %></span>
          </a>
        <% }); %>
      </div>
    </nav>
