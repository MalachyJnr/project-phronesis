    <header
      class="bg-background-light dark:bg-background-dark px-4 md:px-8 py-4 sticky top-0 z-20 md:flex md:items-center md:justify-between"
    >
      <div class="flex items-center justify-between md:hidden w-full">
        <div class="flex items-center gap-3">
          <img src="/images/school_logo.png" alt="PHRONESIS Logo" class="h-10 w-auto object-contain drop-shadow-sm" onerror="this.src='https://via.placeholder.com/40'">
          <div>
            <h1
              class="text-sm font-bold text-primary dark:text-blue-400 uppercase tracking-wider leading-none"
            >
              PHRONESIS
            </h1>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">
              Secondary School
            </p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <button
            id="theme-toggle"
            class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            onclick="toggleTheme()"
          >
            <span class="material-icons-outlined text-slate-600 dark:text-slate-400 text-lg" id="theme-icon">dark_mode</span>
          </button>
          <button class="relative p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors" onclick="toggleNotifications()">
            <span
              class="material-icons-outlined text-slate-600 dark:text-slate-400"
              >notifications</span
            >
            <span
              class="absolute top-0 right-0 bg-secondary text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full font-bold border-2 border-white dark:border-slate-900"
              >2</span
            >
          </button>
          <button
            class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center hover:ring-2 hover:ring-primary/20 dark:hover:ring-blue-400/20 transition-all"
            onclick="toggleProfile()"
          >
            <span
              class="material-icons-outlined text-slate-600 dark:text-slate-400"
              >person</span
            >
          </button>
        </div>
      </div>
      
      <!-- Desktop Header Content -->
      <div class="hidden md:flex flex-1 items-center justify-between">
        <h2 class="text-2xl font-bold dark:text-white tracking-tight"><%= typeof headerTitle !== 'undefined' ? headerTitle : 'Dashboard' %></h2>
        <div class="flex items-center gap-5">
          <button class="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="toggleTheme()" title="Toggle Theme">
            <span class="material-icons-outlined text-[20px]" id="theme-icon-desktop">dark_mode</span>
          </button>
          <button class="relative w-10 h-10 rounded-full flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="toggleNotifications()" title="Notifications">
            <span class="material-icons-outlined text-[20px]">notifications</span>
            <span class="absolute top-2.5 right-2.5 bg-red-500 text-white text-[0px] w-2 h-2 rounded-full border border-background-light dark:border-background-dark"></span>
          </button>
          <div class="h-6 border-l border-slate-200 dark:border-slate-700 mx-1"></div>
          <a href="/student/settings" class="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" title="Settings">
            <span class="material-icons-outlined text-[20px]">settings</span>
          </a>
        </div>
      </div>
    </header>
