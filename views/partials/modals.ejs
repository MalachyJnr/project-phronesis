    <!-- Global Overlay -->
    <div id="menu-overlay" class="fixed inset-0 bg-black/50 z-40 hidden" onclick="closeAllMenus()"></div>

    <!-- Notification Panel -->
    <div id="notification-panel" class="fixed top-0 right-0 h-full w-[320px] bg-white dark:bg-slate-900 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 dark:border-slate-800">
      <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h3 class="font-bold text-lg">Notifications</h3>
        <button onclick="toggleNotifications()" class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full">
          <span class="material-icons-outlined">close</span>
        </button>
      </div>
      <div class="p-4 space-y-4 overflow-y-auto h-[calc(100%-60px)]">
        <!-- New Result -->
        <div class="flex gap-3 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800/50">
          <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
            <span class="material-icons-outlined text-white text-sm">fact_check</span>
          </div>
          <div class="flex-1">
            <p class="text-xs font-bold">New Results Available</p>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Mid-term results for Term 2 have been published.</p>
            <span class="text-[9px] text-slate-400 mt-2 block">2 hours ago</span>
          </div>
        </div>
        <!-- Payment Due -->
        <div class="flex gap-3 p-3 bg-primary/10 rounded-xl border border-primary/20 dark:border-primary/30">
          <div class="w-8 h-8 bg-secondary rounded-full flex items-center justify-center flex-shrink-0">
            <span class="material-icons-outlined text-white text-sm">payments</span>
          </div>
          <div class="flex-1">
            <p class="text-xs font-bold">Outstanding Balance</p>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">Please settle your Term 3 fees to avoid service disruption.</p>
            <span class="text-[9px] text-slate-400 mt-2 block">1 day ago</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Profile Dropdown -->
    <div id="profile-dropdown" class="fixed top-16 right-4 w-48 bg-white dark:bg-slate-900 shadow-2xl rounded-2xl border border-slate-100 dark:border-slate-800 z-50 hidden overflow-hidden mr-[max(0px,calc((100vw-480px)/2))]">
      <div class="p-4 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
        <p class="text-xs font-bold text-slate-900 dark:text-white">
          <%= typeof user !== 'undefined' && user ? user.first_name + ' ' + user.last_name : 'John Sunesis' %>
        </p>
        <p class="text-[10px] text-slate-500 dark:text-slate-400">
          Class: <%= typeof user !== 'undefined' && user ? user.class_name : 'Jss1A' %>
        </p>
      </div>
      <div class="p-2">
        <a href="/student/profile" class="w-full flex items-center gap-3 px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors text-slate-700 dark:text-slate-300">
          <span class="material-icons-outlined text-sm text-slate-400">person</span>
          My Profile
        </a>
        <a href="/student/settings" class="w-full flex items-center gap-3 px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors text-slate-700 dark:text-slate-300">
          <span class="material-icons-outlined text-sm text-slate-400">settings</span>
          Account Settings
        </a>
        <div class="my-1 border-t border-slate-100 dark:border-slate-800"></div>
        <button onclick="logout()" class="w-full flex items-center gap-3 px-3 py-2 text-xs text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors">
          <span class="material-icons-outlined text-sm">logout</span>
          Logout
        </button>
      </div>
    </div>

    <!-- Timetable Action Menu -->
    <div id="timetable-action-menu" class="fixed w-48 bg-white dark:bg-slate-900 shadow-2xl rounded-2xl border border-slate-100 dark:border-slate-800 z-50 hidden overflow-hidden">
      <div class="px-4 py-2 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
        <p id="menu-subject-name" class="text-[10px] font-bold text-primary dark:text-blue-400 uppercase tracking-wider"></p>
      </div>
      <div class="p-2 text-slate-900 dark:text-slate-100">
        <button class="w-full flex items-center gap-3 px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors" onclick="showSubjectDetails(document.getElementById('menu-subject-name').textContent)">
          <span class="material-icons-outlined text-sm text-slate-400">info</span>
          View Class Details
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors" onclick="showAddNote(document.getElementById('menu-subject-name').textContent)">
          <span class="material-icons-outlined text-sm text-slate-400">edit_note</span>
          Add Private Note
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2 text-xs hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg transition-colors" onclick="showCourseMaterials(document.getElementById('menu-subject-name').textContent)">
          <span class="material-icons-outlined text-sm text-slate-400">link</span>
          Course Materials
        </button>
      </div>
    </div>

    <!-- Global Modal Backdrop -->
    <div id="modal-backdrop" class="fixed inset-0 z-[59] hidden bg-slate-950/50 backdrop-blur-sm transition-opacity duration-300 opacity-0" onclick="closeModal()"></div>

    <!-- Global Modal -->
    <div
      id="global-modal"
      class="fixed inset-0 z-[60] hidden items-center justify-center p-4 pointer-events-none"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
    >
      <div
        id="modal-card"
        class="bg-white dark:bg-slate-900 w-full max-w-sm rounded-3xl shadow-2xl overflow-hidden relative pointer-events-auto transition-all duration-300 opacity-0 scale-95"
      >
        <!-- Standard Modal Header (used for content-driven modals like timetable, receipt, etc.) -->
        <div id="modal-header" class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-800/50">
          <h3 id="modal-title" class="font-bold text-slate-900 dark:text-white">Modal Title</h3>
          <button onclick="closeModal()" class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors" aria-label="Close modal">
            <span class="material-icons-outlined text-slate-500">close</span>
          </button>
        </div>

        <!-- Feedback Modal Header (used for success / error / warning / info) — hidden by default -->
        <div id="feedback-modal-header" class="hidden relative pt-8 pb-4 px-6 text-center">
          <!-- Accent bar at top (coloured by type) -->
          <div id="feedback-accent-bar" class="absolute top-0 left-0 right-0 h-1 rounded-t-3xl"></div>
          <!-- Icon circle -->
          <div id="feedback-icon-circle" class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <span id="feedback-icon" class="material-icons-outlined text-3xl"></span>
          </div>
          <h3 id="feedback-modal-title" class="text-lg font-black text-slate-900 dark:text-white leading-snug"></h3>
        </div>

        <div id="modal-body" class="p-6">
          <!-- Modal content injected by JS -->
        </div>
      </div>
    </div>
