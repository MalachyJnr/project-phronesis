<!doctype html>
<html lang="en">
  <head>
<%- include('partials/head', { title: 'Profile - PHRONESIS' }) %>
  </head>
  <body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen md:flex">
<%- include('partials/sidebar', { activePage: 'profile' }) %>

    <!-- Main Container -->
    <div id="page-container" class="max-w-[480px] md:max-w-none md:ml-[260px] md:flex-1 w-full mx-auto md:mx-0 bg-background-light dark:bg-background-dark min-h-screen relative fade-in ">
    
<%- include('partials/header', { headerTitle: 'Student Profile' }) %>

<main class="p-4 md:px-8 md:py-6 space-y-6 md:space-y-8 pb-32 md:pb-8">

        <div class="md:grid md:grid-cols-1 lg:grid-cols-[1fr_2fr] md:gap-8 lg:gap-10">
          
        <!-- Profile Hero & Quick Stats Container (Left Sidebar on Large Screens) -->
        <div class="space-y-6 md:space-y-8">
          <!-- Profile Hero -->
          <section class="text-center space-y-4 bg-white dark:bg-slate-800 p-6 rounded-3xl border border-slate-100 dark:border-slate-700 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-br from-primary/20 to-primary/5 dark:from-blue-900/30 dark:to-slate-800"></div>
            <div class="relative inline-block mt-4">
              <div class="w-24 h-24 md:w-32 md:h-32 rounded-full bg-slate-200 dark:bg-slate-800 flex items-center justify-center border-4 border-white dark:border-slate-900 overflow-hidden mx-auto shadow-md">
                <span class="material-icons-outlined text-5xl md:text-6xl text-slate-400">person</span>
              </div>
              <button class="absolute bottom-1 right-1 p-2 bg-primary text-white rounded-full border-2 border-white dark:border-slate-900 hover:scale-110 shadow-lg transition-transform">
                <span class="material-icons-outlined text-xs md:text-sm">edit</span>
              </button>
            </div>
            <div class="relative z-10 pt-2 pb-2">
              <h2 class="text-xl md:text-2xl font-bold dark:text-white"><%= user.first_name %> <%= user.last_name %></h2>
              <p class="text-sm text-slate-500 dark:text-slate-400 font-medium md:mt-1">Student ID: <%= user.admission_number %></p>
              <div class="flex items-center justify-center gap-2 mt-4">
                <span class="px-3 py-1 bg-primary/10 text-primary dark:text-blue-400 text-[10px] md:text-xs font-bold rounded-lg uppercase tracking-wide"><%= user.class_name %></span>
                <span class="px-3 py-1 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-[10px] md:text-xs font-bold rounded-lg uppercase tracking-wide">Active</span>
              </div>
            </div>
          </section>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3 md:gap-4">
            <div class="bg-white dark:bg-slate-800 p-4 md:p-5 rounded-2xl text-center border border-slate-100 dark:border-slate-700 shadow-sm transition-all hover:-translate-y-1">
              <p class="text-[10px] md:text-xs text-slate-500 uppercase font-bold tracking-wider mb-1">GPA</p>
              <p class="text-xl md:text-3xl font-bold text-primary dark:text-blue-400">3.8</p>
            </div>
            <div class="bg-white dark:bg-slate-800 p-4 md:p-5 rounded-2xl text-center border border-slate-100 dark:border-slate-700 shadow-sm transition-all hover:-translate-y-1">
              <p class="text-[10px] md:text-xs text-slate-500 uppercase font-bold tracking-wider mb-1">Attendance</p>
              <p class="text-xl md:text-3xl font-bold text-primary dark:text-blue-400">90%</p>
            </div>
            <div class="bg-white dark:bg-slate-800 p-4 md:p-5 rounded-2xl text-center border border-slate-100 dark:border-slate-700 shadow-sm transition-all hover:-translate-y-1">
              <p class="text-[10px] md:text-xs text-slate-500 uppercase font-bold tracking-wider mb-1">Rank</p>
              <p class="text-xl md:text-3xl font-bold text-secondary">5th</p>
            </div>
          </div>
        </div>

        <!-- Details Sections (Right Flow on Large Screens) -->
        <div class="space-y-4 md:space-y-6 lg:mt-0">
          <!-- Personal Information -->
          <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="bg-slate-50 dark:bg-slate-800/50 px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
              <h3 class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-wider">Personal Information</h3>
              <button class="text-primary hover:text-blue-600 transition-colors hidden md:block" title="Edit Information">
                <span class="material-icons-outlined text-sm">edit</span>
              </button>
            </div>
            <div class="p-4 md:p-6 md:grid md:grid-cols-2 md:grid-rows-2 md:gap-x-6 gap-y-4 space-y-4 md:space-y-0 text-left">
              <div class="flex items-center justify-between md:flex-col md:items-start md:justify-center md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <span class="text-xs text-slate-500 md:mb-1">Date of Birth</span>
                <span class="text-xs md:text-sm font-semibold dark:text-slate-200"><%= user.date_of_birth %></span>
              </div>
              <div class="flex items-center justify-between md:flex-col md:items-start md:justify-center md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <span class="text-xs text-slate-500 md:mb-1">Gender</span>
                <span class="text-xs md:text-sm font-semibold dark:text-slate-200"><%= user.gender %></span>
              </div>
              <div class="flex items-center justify-between md:flex-col md:items-start md:justify-center md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <span class="text-xs text-slate-500 md:mb-1">Blood Group</span>
                <span class="text-xs md:text-sm font-semibold text-slate-700 dark:text-slate-300">O+</span>
              </div>
              <div class="hidden md:flex flex-col items-start justify-center bg-background-light dark:bg-slate-900/50 p-3 rounded-xl border border-transparent dark:border-slate-700/50">
                <span class="text-xs text-slate-500 mb-1">State of Origin</span>
                <span class="text-xs md:text-sm font-semibold dark:text-slate-200">Lagos State</span>
              </div>
            </div>
          </section>

          <!-- Contact Details -->
          <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="bg-slate-50 dark:bg-slate-800/50 px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
              <h3 class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-wider">Contact Details</h3>
              <button class="text-primary hover:text-blue-600 transition-colors hidden md:block" title="Edit Contact">
                <span class="material-icons-outlined text-sm">edit</span>
              </button>
            </div>
            <div class="p-4 md:p-6 space-y-4 md:space-y-5">
              <div class="flex items-center gap-3 md:gap-4 md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-primary dark:text-blue-400">
                  <span class="material-icons-outlined text-sm md:text-base">email</span>
                </div>
                <div>
                  <p class="text-[10px] md:text-xs text-slate-500 uppercase md:font-medium">Email Address</p>
                  <p class="text-xs md:text-sm font-semibold dark:text-slate-200">john.sunesis@school.com</p>
                </div>
              </div>
              <div class="flex items-center gap-3 md:gap-4 md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-primary/10 text-primary dark:text-blue-400 flex items-center justify-center">
                  <span class="material-icons-outlined text-sm md:text-base">phone</span>
                </div>
                <div>
                  <p class="text-[10px] md:text-xs text-slate-500 uppercase md:font-medium">Phone Number</p>
                  <p class="text-xs md:text-sm font-semibold dark:text-slate-200">+234 812 345 6789</p>
                </div>
              </div>
              <div class="flex items-center gap-3 md:gap-4 md:bg-background-light md:dark:bg-slate-900/50 md:p-3 md:rounded-xl md:border md:border-transparent dark:md:border-slate-700/50">
                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-primary/10 text-primary dark:text-blue-400 flex items-center justify-center">
                  <span class="material-icons-outlined text-sm md:text-base">home</span>
                </div>
                <div>
                  <p class="text-[10px] md:text-xs text-slate-500 uppercase md:font-medium">Home Address</p>
                  <p class="text-xs md:text-sm font-semibold dark:text-slate-200">12 Sunesis Way, Lekki Phase 1, Lagos</p>
                </div>
              </div>
            </div>
          </section>

          <!-- Emergency Contact -->
          <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="bg-slate-50 dark:bg-slate-800/50 px-4 py-3 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between">
              <h3 class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-wider">Emergency Contact</h3>
              <button class="text-primary hover:text-blue-600 transition-colors hidden md:block" title="Edit Contact">
                <span class="material-icons-outlined text-sm">edit</span>
              </button>
            </div>
            <div class="p-4 md:p-6 flex items-center justify-between">
              <div class="flex items-center gap-3 md:gap-4">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-400">
                  <span class="material-icons-outlined md:text-[24px]">person</span>
                </div>
                <div>
                  <h4 class="text-sm md:text-base font-bold dark:text-white">Mr. Sunesis Sr.</h4>
                  <p class="text-[10px] md:text-xs text-slate-500 uppercase font-medium mt-0.5">Relationship: Father</p>
                </div>
              </div>
              <button class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-primary/10 text-primary dark:text-blue-400 flex items-center justify-center hover:bg-primary/20 hover:scale-105 active:scale-95 transition-all shadow-sm">
                <span class="material-icons-outlined md:text-[24px]">call</span>
              </button>
            </div>
          </section>
        </div>
        </div> <!-- End of Page Grid Wrapper -->
      
    </main>

<%- include('partials/bottom-nav', { activePage: 'profile' }) %>
<%- include('partials/modals') %>

    </div>
  </body>
</html>