<!doctype html>
<html lang="en">
  <head>
<%- include('partials/head', { title: 'Results - PHRONESIS' }) %>
  </head>
  <body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen md:flex">
<%- include('partials/sidebar', { activePage: 'results' }) %>

    <!-- Main Container -->
    <div id="page-container" class="max-w-[480px] md:max-w-none md:ml-[260px] md:flex-1 w-full mx-auto md:mx-0 bg-background-light dark:bg-background-dark min-h-screen relative fade-in pb-20 md:pb-0">
    
<%- include('partials/header', { headerTitle: 'Academic Results' }) %>

<main class="p-4 md:px-8 md:py-6 space-y-6 md:space-y-8 pb-24 md:pb-8">

      <!-- Mobile Welcome Area -->
      <section class="md:hidden">
        <h2 class="text-2xl font-bold dark:text-white">Academic Results</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
          View your grades and performance across all subjects.
        </p>
      </section>

      <!-- Academic Session & Term Selectors -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Session Dropdown -->
        <div class="flex items-center gap-3">
          <label for="session-select" class="text-sm font-semibold text-slate-500 dark:text-slate-400">Academic Session:</label>
          <div class="relative">
            <select 
              id="session-select" 
              onchange="changeSession(this.value)" 
              data-selected-session="<%= selectedSessionId %>"
              data-selected-term="<%= selectedTermId %>"
              class="appearance-none pl-4 pr-10 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-sm font-bold focus:outline-none focus:ring-2 focus:ring-primary/20 dark:focus:ring-blue-400/20 cursor-pointer shadow-sm"
            >
              <% sessions.forEach(s => { %>
                <option value="<%= s.session_id %>" <%= s.session_id === selectedSessionId ? 'selected' : '' %>><%= s.session_name %></option>
              <% }) %>
            </select>
            <span class="material-icons-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-base">expand_more</span>
          </div>
        </div>

        <!-- Term Selector - Mobile Tabs -->
        <div class="md:hidden flex overflow-x-auto gap-2 pb-2 hide-scrollbar">
          <% terms.forEach(t => { %>
            <button
              onclick="changeTerm('<%= t.term_id %>')"
              class="px-4 py-2 <%= t.term_id === selectedTermId ? 'bg-secondary text-white font-bold' : 'bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-medium' %> rounded-full text-xs transition-all tracking-wide shadow-sm"
            >
              <%= t.term_name %>
            </button>
          <% }) %>
        </div>
        
        <!-- Term Selector - Desktop Tabs -->
        <div class="hidden md:flex bg-slate-50 dark:bg-slate-900/50 rounded-lg p-1.5 gap-1 w-fit border border-slate-100 dark:border-slate-800">
          <% terms.forEach(t => { %>
             <button 
               onclick="changeTerm('<%= t.term_id %>')" 
               class="px-6 py-2 <%= t.term_id === selectedTermId ? 'bg-white dark:bg-slate-800 shadow-sm text-slate-900 dark:text-white font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 font-medium' %> rounded-md text-sm transition-all"
             >
               <%= t.term_name %>
             </button>
          <% }) %>
        </div>
      </div>

      <!-- Performance Summary Cards -->
      <% if (summary) { %>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        <div
          class="bg-gradient-to-br from-[#3B82F6] to-blue-700 p-5 md:p-6 rounded-2xl text-white shadow-lg shadow-blue-500/10 md:h-40 flex flex-col justify-between"
        >
          <div class="flex items-center gap-2 mb-3 md:mb-0">
            <div class="p-1.5 bg-white/20 rounded-lg">
              <span class="material-icons-outlined text-[18px]">star_rate</span>
            </div>
            <span class="text-xs md:text-sm font-medium opacity-90">Overall GPA</span>
          </div>
          <div>
            <div class="text-3xl md:text-5xl font-bold tracking-tight mb-1"><%= Number(summary.gpa).toFixed(2) %></div>
            <p class="text-[11px] md:text-sm md:font-light opacity-80 leading-tight">CGPA: <%= Number(summary.cgpa).toFixed(2) %></p>
          </div>
        </div>
        <div
          class="bg-gradient-to-br from-[#FBBF24] to-amber-600 p-5 md:p-6 rounded-2xl text-white shadow-lg shadow-amber-500/10 md:h-40 flex flex-col justify-between"
        >
          <div class="flex items-center gap-2 mb-3 md:mb-0">
            <div class="p-1.5 bg-white/20 rounded-lg">
              <span class="material-icons-outlined text-[18px]">emoji_events</span>
            </div>
            <span class="text-xs md:text-sm font-medium opacity-90">Class Rank</span>
          </div>
          <div>
            <div class="text-3xl md:text-5xl font-bold tracking-tight mb-1">
              <%= summary.class_position %><%= [ 'st', 'nd', 'rd' ][(summary.class_position % 10 - 1)] || 'th' %>
            </div>
            <p class="text-[11px] md:text-sm md:font-light opacity-80 leading-tight">Out of <%= summary.total_students %></p>
          </div>
        </div>
        
        <div class="hidden lg:flex col-span-2 bg-[#252E3E] dark:bg-slate-800 p-6 rounded-2xl border border-slate-700/50 flex flex-col justify-center relative overflow-hidden h-40">
           <div class="relative z-10 flex flex-col justify-between h-full">
               <div>
                 <h3 class="text-white text-lg font-bold mb-1">Full Report Available</h3>
                 <p class="text-slate-400 text-sm">Download your official academic transcript.</p>
               </div>
             <button onclick="triggerReportDownload()" class="px-5 py-2.5 bg-primary hover:bg-blue-600 text-white rounded-lg text-xs font-bold transition-colors w-fit shadow-lg shadow-blue-500/20">Download PDF</button>
           </div>
           <span class="material-icons-outlined absolute -right-4 -bottom-4 text-8xl text-slate-700/50 z-0 select-none pointer-events-none transform -rotate-12">description</span>
        </div>
      </div>
      <% } else { %>
      <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-100 dark:border-slate-700 text-center py-16">
        <span class="material-icons-outlined text-6xl text-slate-300 dark:text-slate-600 mb-4">analytics</span>
        <h3 class="text-lg font-bold mb-1">No Results Found</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm max-w-md mx-auto">
          No official result summary has been uploaded for the selected session and term. Please contact the administrator for details.
        </p>
      </div>
      <% } %>

      <!-- Subject Results Breakdown -->
      <% if (summary && subjectResults.length > 0) { %>
      <section class="space-y-3 md:space-y-4">
        <div class="flex items-center justify-between pb-2 md:pb-4 border-b border-slate-100 dark:border-slate-700">
            <h3 class="text-lg font-bold dark:text-white">Subject Breakdown</h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-3 md:gap-4 lg:gap-6">
        
        <% subjectResults.forEach(sub => { %>
          <% 
             let icon = 'calculate';
             if (sub.subject_name.toLowerCase().includes('english')) icon = 'menu_book';
             else if (sub.subject_name.toLowerCase().includes('biology')) icon = 'biotech';
             else if (sub.subject_name.toLowerCase().includes('chemistry')) icon = 'science';
             else if (sub.subject_name.toLowerCase().includes('physics')) icon = 'bolt';
          %>
          <div
            onclick="showSubjectResults('<%= sub.subject_name %>', '<%= sub.grade %>', '<%= Number(sub.total_score).toFixed(0) %>%', '<%= sub.teacher_name || "N/A" %>', '<%= Number(sub.ca_score).toFixed(0) %>/30', '<%= Number(sub.mid_term_score).toFixed(0) %>/20', '<%= Number(sub.exam_score).toFixed(0) %>/50', `<%= sub.subject_remarks || '' %>`)"
            class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 shadow-sm active:scale-[0.98] transition-transform cursor-pointer hover:border-primary/50 dark:hover:border-blue-400/50"
          >
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex items-center justify-center">
                  <span class="material-icons-outlined text-xl"><%= icon %></span>
                </div>
                <div>
                  <h4 class="text-sm font-bold"><%= sub.subject_name %></h4>
                  <p class="text-[10px] text-slate-500 dark:text-slate-400"><%= sub.teacher_name || 'N/A' %></p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <div class="text-2xl font-bold text-primary dark:text-blue-400"><%= sub.grade %></div>
                  <p class="text-[10px] text-slate-500 dark:text-slate-400">
                    <%= sub.total_score >= 90 ? 'Excellent' : sub.total_score >= 80 ? 'Very Good' : sub.total_score >= 70 ? 'Good' : sub.total_score >= 50 ? 'Pass' : 'Need Improvement' %>
                  </p>
                </div>
                <div class="relative w-12 h-12">
                  <svg class="w-full h-full transform -rotate-90">
                    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="4" fill="transparent" class="text-slate-100 dark:text-slate-700" />
                    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="4" fill="transparent" 
                            stroke-dasharray="125.6" 
                            stroke-dashoffset="<%= 125.6 - (125.6 * sub.total_score) / 100 %>" 
                            class="text-primary dark:text-blue-400" />
                  </svg>
                  <span class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-[10px] font-bold text-slate-700 dark:text-slate-200">
                    <%= Number(sub.total_score).toFixed(0) %>%
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
        
        </div>
      </section>
      <% } %>

      <% if (summary) { %>
      <button
        onclick="triggerReportDownload()"
        class="w-full lg:hidden py-3 bg-primary dark:bg-blue-600 text-white rounded-xl text-sm font-bold transition-all active:scale-[0.98] shadow-lg"
      >
        Download Full Report Card
      </button>
      <% } %>
    
    </main>

<%- include('partials/bottom-nav', { activePage: 'results' }) %>
<%- include('partials/modals') %>

    </div>

    <!-- Client-side navigation and results handling moved to navigation.js -->
  </body>
</html>