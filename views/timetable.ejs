<!doctype html>
<html lang="en">
  <head>
<%- include('partials/head', { title: 'Timetable - PHRONESIS' }) %>
    <script>
      const dynamicClassCounts = {
        'Monday': parseInt('<%= (timetableDataGrouped.Monday || []).filter(c => c.color !== "break").length %>'),
        'Tuesday': parseInt('<%= (timetableDataGrouped.Tuesday || []).filter(c => c.color !== "break").length %>'),
        'Wednesday': parseInt('<%= (timetableDataGrouped.Wednesday || []).filter(c => c.color !== "break").length %>'),
        'Thursday': parseInt('<%= (timetableDataGrouped.Thursday || []).filter(c => c.color !== "break").length %>'),
        'Friday': parseInt('<%= (timetableDataGrouped.Friday || []).filter(c => c.color !== "break").length %>')
      };
    </script>
  </head>
  <body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen md:flex">
<%- include('partials/sidebar', { activePage: 'timetable' }) %>

    <!-- Main Container -->
    <div id="page-container" class="max-w-[480px] md:max-w-none md:ml-[260px] md:flex-1 w-full mx-auto md:mx-0 bg-background-light dark:bg-background-dark min-h-screen relative fade-in pb-20 md:pb-0">
    
<%- include('partials/header', { headerTitle: 'Weekly Timetable for ' + user.class_name }) %>

<main class="p-4 md:px-8 md:py-6 space-y-6 md:space-y-8 pb-24 md:pb-8">

      <!-- Mobile Welcome Area -->
      <section class="md:hidden">
        <h2 class="text-2xl font-bold dark:text-white">Weekly Timetable for <%= user.class_name %></h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
          Your complete class schedule for the week.
        </p>
      </section>

      <!-- Day Selector -->
      
      <!-- Mobile Day Selector -->
      <div class="md:hidden flex overflow-x-auto gap-2 pb-2 hide-scrollbar">
        <button
          onclick="switchDay('Monday', this)"
          class="px-4 py-2 bg-secondary text-white rounded-full text-xs font-bold whitespace-nowrap transition-all"
        >
          Monday
        </button>
        <button
          onclick="switchDay('Tuesday', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Tuesday
        </button>
        <button
          onclick="switchDay('Wednesday', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Wednesday
        </button>
        <button
          onclick="switchDay('Thursday', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Thursday
        </button>
        <button
          onclick="switchDay('Friday', this)"
          class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-xs font-medium whitespace-nowrap transition-all"
        >
          Friday
        </button>
      </div>

      <!-- Desktop Day Selector -->
      <div class="hidden md:flex bg-slate-50 dark:bg-slate-900/50 rounded-lg p-1.5 gap-1 w-full max-w-2xl border border-slate-100 dark:border-slate-800">
         <button onclick="switchDay('Monday', this)" class="flex-1 py-2 bg-white dark:bg-slate-800 shadow-sm text-slate-900 dark:text-white rounded-md text-sm font-bold transition-all">Monday</button>
         <button onclick="switchDay('Tuesday', this)" class="flex-1 py-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Tuesday</button>
         <button onclick="switchDay('Wednesday', this)" class="flex-1 py-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Wednesday</button>
         <button onclick="switchDay('Thursday', this)" class="flex-1 py-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Thursday</button>
         <button onclick="switchDay('Friday', this)" class="flex-1 py-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 rounded-md text-sm font-medium transition-all">Friday</button>
      </div>

      <!-- Current Day Info -->
      <div class="bg-primary p-4 md:p-6 rounded-2xl text-white shadow-lg md:max-w-md">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs md:text-sm opacity-90 mb-1">Schedule for</p>
            <h3 id="current-day-label" class="text-xl md:text-2xl font-bold">Monday</h3>
            <p id="class-count" class="text-xs md:text-sm md:font-medium opacity-75 mt-1">
              <%= (timetableDataGrouped.Monday || []).filter(c => c.color !== 'break').length %> classes scheduled
            </p>
          </div>
          <div class="w-16 h-16 md:w-20 md:h-20 bg-white/20 rounded-full flex items-center justify-center shrink-0">
            <span class="material-icons-outlined text-4xl md:text-5xl">today</span>
          </div>
        </div>
      </div>

      <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'].forEach(function(day) { %>
      <section id="<%= day.toLowerCase() %>-schedule" class="schedule-section space-y-3 <%= day === 'Monday' ? '' : 'hidden' %>">
        <h3 class="text-lg font-bold dark:text-white flex items-center gap-2 mb-2 md:mb-4">
          <span class="material-icons-outlined text-primary">schedule</span>
          <%= day %> Schedule
        </h3>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-3 md:gap-4 lg:gap-6">
          <% if (timetableDataGrouped[day] && timetableDataGrouped[day].length > 0) { %>
            <% timetableDataGrouped[day].forEach(function(item) { %>
              <% if (item.color === 'break') { %>
                <!-- Break/Lunch card -->
                <div class="bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-dashed border-slate-200 dark:border-slate-700 flex items-center justify-between">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-12 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 rounded-lg flex flex-col items-center justify-center">
                      <span class="text-xs font-bold"><%= item.time %></span>
                    </div>
                    <div>
                      <h4 class="text-xs font-semibold text-slate-500 dark:text-slate-400 italic">
                        <%= item.subject %>
                      </h4>
                      <p class="text-[10px] text-slate-400 dark:text-slate-500">
                        <%= item.subject === 'Lunch Break' ? '45 minutes' : '15 minutes' %>
                      </p>
                    </div>
                  </div>
                  <% if (item.subject === 'Lunch Break') { %>
                    <span class="material-icons-outlined text-secondary/50">restaurant</span>
                  <% } %>
                </div>
              <% } else { %>
                <!-- Subject card -->
                <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-100 dark:border-slate-700 flex items-center justify-between shadow-sm">
                  <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-primary/10 text-primary dark:text-blue-400 rounded-lg flex flex-col items-center justify-center">
                      <span class="text-xs font-bold"><%= item.time %></span>
                      <span class="text-[9px] uppercase"><%= item.period %></span>
                    </div>
                    <div>
                      <h4 class="text-sm font-bold"><%= item.subject %></h4>
                      <p class="text-[10px] text-slate-500 dark:text-slate-400">
                        <%= item.room %> • <%= item.teacher %>
                      </p>
                    </div>
                  </div>
                  <button class="p-1 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors text-slate-300 hover:text-primary dark:hover:text-blue-400" onclick="toggleTimetableMenu(event, '<%= item.subject %>')">
                    <span class="material-icons-outlined">more_vert</span>
                  </button>
                </div>
              <% } %>
            <% }); %>
          <% } else { %>
            <div class="col-span-full py-8 text-center text-slate-500 dark:text-slate-400">
              <span class="material-icons-outlined text-4xl mb-2 opacity-50">event_busy</span>
              <p class="text-sm">No classes scheduled for <%= day %></p>
            </div>
          <% } %>
        </div>
      </section>
      <% }); %>

    </main>

<%- include('partials/bottom-nav', { activePage: 'timetable' }) %>
<%- include('partials/modals') %>

    </div>
  </body>
</html>